# Server
PORT=8000

# CORS (comma-separated). Use * only for local dev.
CORS_ORIGINS=http://localhost:3000

# Upload handling
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=temp_uploads

# External services
# Preferred key name
GOOGLE_VISION_API_KEY=
# Backward compatibility alias (either key works)
GOOGLE_CLOUD_VISION_API_KEY=
GEMINI_API_KEY=
