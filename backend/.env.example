PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/spendsense

# Firebase session verification (Admin SDK service account JSON path)
FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

# Optional ML keys if backend later proxies ML calls
GOOGLE_VISION_API_KEY=
GEMINI_API_KEY=

# ML service URL for statement processing
ML_SERVICE_URL=http://127.0.0.1:8000
